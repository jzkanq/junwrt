#!/bin/sh /etc/rc.common
# ==============================================================================
# JunSpeedPatch MAX: Dynamic CPU scaling and 4-core software packet steering
# Target: MediaTek MT6890 / T750 (4x ARM Cortex-A55) & MT7915 Wi-Fi 6
# Throughput and hardware NAT activity require a live measurement.
# ==============================================================================

# Direct installer handling when invoked as: sh /tmp/junspeedpatch.sh install
if [ "$1" = "install" ]; then
    echo "=================================================================="
    echo " [*] Installing JunSpeedPatch MAX to /etc/init.d/junspeedpatch... "
    echo "=================================================================="
    cp -f "$0" /etc/init.d/junspeedpatch
    chmod 0755 /etc/init.d/junspeedpatch
    /etc/init.d/junspeedpatch enable
    /etc/init.d/junspeedpatch start
    echo "[+] SUCCESS: JunSpeedPatch MAX is installed and running!"
    exit 0
fi

if [ "$1" = "uninstall" ] || [ "$1" = "remove" ]; then
    echo "=================================================================="
    echo " [*] Uninstalling JunSpeedPatch from Router...                    "
    echo "=================================================================="
    /etc/init.d/junspeedpatch stop 2>/dev/null || true
    /etc/init.d/junspeedpatch disable 2>/dev/null || true
    rm -f /etc/init.d/junspeedpatch
    echo "[+] SUCCESS: JunSpeedPatch has been completely removed."
    exit 0
fi

START=99
STOP=10

EXTRA_COMMANDS="status steer"
EXTRA_HELP="	status	View CPU, network and cached cellular diagnostics
	steer [device]	Apply packet steering after an interface is created"
SPEED_ROOT="${JUNWRT_SPEED_ROOT:-}" # Test fixture prefix; empty on the router.

steer_device() {
    local iface="$1"
    local ifpath="$SPEED_ROOT/sys/class/net/$iface"
    local q
    case "$iface" in ''|lo|*[!A-Za-z0-9_.-]*) return 0 ;; esac
    [ -d "$ifpath" ] || return 0
    ip link set "$iface" txqueuelen 10000 2>/dev/null || true
    for q in "$ifpath"/queues/rx-*; do
        [ -d "$q" ] || continue
        [ ! -w "$q/rps_cpus" ] || echo f > "$q/rps_cpus" 2>/dev/null || true
        [ ! -w "$q/rps_flow_cnt" ] || echo 32768 > "$q/rps_flow_cnt" 2>/dev/null || true
    done
    for q in "$ifpath"/queues/tx-*; do
        [ -d "$q" ] || continue
        [ ! -w "$q/xps_cpus" ] || echo f > "$q/xps_cpus" 2>/dev/null || true
    done
    if command -v ethtool >/dev/null 2>&1; then
        ethtool -K "$iface" gro on 2>/dev/null || true
        ethtool -K "$iface" gso on 2>/dev/null || true
        ethtool -K "$iface" tso on 2>/dev/null || true
    fi
}

steer() {
    local ifpath
    if [ "$#" -gt 0 ]; then
        steer_device "$1"
    else
        for ifpath in "$SPEED_ROOT"/sys/class/net/*; do
            [ -d "$ifpath" ] || continue
            steer_device "${ifpath##*/}"
        done
    fi
}

start() {
    echo "=================================================================="
    echo " [*] Activating JunSpeedPatch MAX: 5G & 4-Core Balanced Booster   "
    echo "=================================================================="

    # 1. CPU Dynamic Frequency Scaling (Energy-Saving Idle + 2.0 GHz Burst)
    echo "[1/6] Configuring Energy-Aware Dynamic CPU Frequency Governor..."
    local chosen_gov=""
    local avail_govs
    avail_govs=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors 2>/dev/null || echo "")

    case "$avail_govs" in
        *schedutil*) chosen_gov="schedutil" ;;
        *ondemand*)  chosen_gov="ondemand" ;;
        *)           chosen_gov="" ;;
    esac

    if [ -n "$chosen_gov" ]; then
        for gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
            [ -w "$gov" ] && echo "$chosen_gov" > "$gov" 2>/dev/null
        done
        echo "  [CPU] Dynamic Governor active: $chosen_gov (Sips low power on idle, bursts to 2.0 GHz)"

        if [ "$chosen_gov" = "ondemand" ] && [ -d /sys/devices/system/cpu/cpufreq/ondemand ]; then
            [ -w /sys/devices/system/cpu/cpufreq/ondemand/up_threshold ] && echo 80 > /sys/devices/system/cpu/cpufreq/ondemand/up_threshold 2>/dev/null
            [ -w /sys/devices/system/cpu/cpufreq/ondemand/sampling_down_factor ] && echo 5 > /sys/devices/system/cpu/cpufreq/ondemand/sampling_down_factor 2>/dev/null
        fi
    else
        echo "  [CPU] Dynamic scaling active"
    fi

    # 2. 4-Core Software Packet Steering (RPS/XPS bitmask f) Across All Cores
    echo "[2/6] Enabling 4-Core Packet Steering (RPS/XPS) & HW Offloads..."
    steer

    # 3. Flow Offload Optimization (Protects Xray, Passwall, OpenClash & Enables MTK HW NAT)
    echo "[3/6] Optimizing Flow Offloading for Xray & MediaTek Hardware NAT..."
    if command -v uci >/dev/null 2>&1; then
        uci set firewall.@defaults[0].flow_offloading='0' 2>/dev/null || true
        uci set firewall.@defaults[0].flow_offloading_hw='0' 2>/dev/null || true
        uci commit firewall 2>/dev/null || true
        /etc/init.d/firewall reload 2>/dev/null || true
        echo "  [FlowOffload] Generic flow offload disabled (Protects Xray/Passwall & enables MTK Warp HW NAT)"
    fi

    # SSH & System Stability Tuning
    if command -v uci >/dev/null 2>&1; then
        uci -q set dropbear.@dropbear[0].IdleTimeout='0' 2>/dev/null || true
        uci -q commit dropbear 2>/dev/null || true
    fi
    # The sanitized antenna service controls the actual RF path. Do not disable it.

    # 4. Cellular WAN & VPN MSS Clamping (Full Line-Rate Upload & Zero-Stall Xray Fix)
    echo "[4/6] Enforcing TCP MSS Clamping on Cellular & WAN Forwarding..."
    if command -v iptables >/dev/null 2>&1; then
        iptables -t mangle -C FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || \
        iptables -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || true
    fi

    if command -v ip6tables >/dev/null 2>&1; then
        ip6tables -t mangle -C FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || \
        ip6tables -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || true
    fi

    # 5. High-Throughput 8MB Socket Buffers & Low-Latency Network Stack
    echo "[5/6] Injected High-Throughput Socket Buffers & Low-Latency Stack..."
    sysctl -w net.core.rmem_max=8388608 >/dev/null 2>&1
    sysctl -w net.core.wmem_max=8388608 >/dev/null 2>&1
    sysctl -w net.core.rmem_default=262144 >/dev/null 2>&1
    sysctl -w net.core.wmem_default=262144 >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_rmem="4096 131072 8388608" >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_wmem="4096 65536 8388608" >/dev/null 2>&1

    sysctl -w net.core.netdev_max_backlog=10000 >/dev/null 2>&1
    sysctl -w net.core.netdev_budget=600 >/dev/null 2>&1
    sysctl -w net.core.rps_sock_flow_entries=32768 >/dev/null 2>&1

    sysctl -w net.ipv4.tcp_fastopen=3 >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_slow_start_after_idle=0 >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_timestamps=1 >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_window_scaling=1 >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_sack=1 >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_dsack=1 >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_tw_reuse=1 >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_fin_timeout=15 >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_max_syn_backlog=4096 >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_syncookies=1 >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_moderate_rcvbuf=1 >/dev/null 2>&1

    # TCP Keepalive Tuning for Xray/VPN long-lived tunnels
    sysctl -w net.ipv4.tcp_keepalive_time=300 >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_keepalive_intvl=15 >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_keepalive_probes=5 >/dev/null 2>&1

    sysctl -w net.netfilter.nf_conntrack_max=65536 >/dev/null 2>&1
    sysctl -w net.netfilter.nf_conntrack_tcp_timeout_established=7200 >/dev/null 2>&1
    sysctl -w vm.vfs_cache_pressure=50 >/dev/null 2>&1

    # 6. Ethernet EEE Power Savings Off (Zero Link Drops)
    echo "[6/6] Enforcing Low-Latency Gigabit Ethernet (EEE Off)..."

    if command -v ethtool >/dev/null 2>&1; then
        for eth_dev in eth0 eth1 eth0.1 eth0.2; do
            if [ -d "/sys/class/net/$eth_dev" ]; then
                ethtool --set-eee "$eth_dev" eee off 2>/dev/null || true
            fi
        done
    fi

    echo "=================================================================="
    echo " [+] JunSpeedPatch configured (4-Core RPS, generic offload off) "
    echo "=================================================================="
}

stop() {
    echo "=================================================================="
    echo " [*] Reverting JunSpeedPatch to Stock Defaults...                 "
    echo "=================================================================="

    for ifpath in "$SPEED_ROOT"/sys/class/net/*; do
        [ -d "$ifpath" ] || continue
        for q in "$ifpath"/queues/rx-*; do
            [ -d "$q" ] || continue
            [ -w "$q/rps_cpus" ] && echo 0 > "$q/rps_cpus" 2>/dev/null || true
        done
        for q in "$ifpath"/queues/tx-*; do
            [ -d "$q" ] || continue
            [ -w "$q/xps_cpus" ] && echo 0 > "$q/xps_cpus" 2>/dev/null || true
        done
    done

    # MSS rules also belong to firewall.user; stopping steering must not remove them.
    echo "  [+] Software packet steering stopped; persistent MSS rules retained."
    echo "=================================================================="
}

status() {
    echo "=================================================================="
    echo " JunSpeedPatch MAX: Real-Time Hardware & Network Telemetry        "
    echo "=================================================================="

    echo "--- 1. 4-Core CPU Frequency & Power Scaling ---"
    for i in 0 1 2 3; do
        local cpupath="$SPEED_ROOT/sys/devices/system/cpu/cpu$i/cpufreq"
        if [ -d "$cpupath" ]; then
            local freq_khz
            freq_khz=$(cat "$cpupath/scaling_cur_freq" 2>/dev/null || echo "0")
            local freq_mhz=$((freq_khz / 1000))
            local gov
            gov=$(cat "$cpupath/scaling_governor" 2>/dev/null || echo "unknown")
            echo "  CPU $i: ${freq_mhz} MHz [Governor: $gov]"
        else
            echo "  CPU $i: Online"
        fi
    done

    echo ""
    echo "--- 2. Hardware / Software Flow Offloading Status ---"
    local fo_sw
    local fo_hw
    fo_sw=$(uci -q get firewall.@defaults[0].flow_offloading || echo "0")
    fo_hw=$(uci -q get firewall.@defaults[0].flow_offloading_hw || echo "0")
    echo "  Generic software flow offloading: $fo_sw (0 = disabled)"
    echo "  Generic hardware flow offloading: $fo_hw (0 = disabled)"
    if grep -q '^mtk_warp ' "$SPEED_ROOT/proc/modules" 2>/dev/null; then
        echo "  Vendor mtk_warp: loaded; accelerated traffic still requires verification"
    else
        echo "  Vendor mtk_warp: not reported in /proc/modules"
    fi

    echo ""
    echo "--- 3. Network Interfaces & 4-Core Packet Steering ---"
    printf "  %-12s %-10s %-12s %s\n" "INTERFACE" "RPS MASK" "TX QUEUE LEN" "STATUS"
    for ifpath in "$SPEED_ROOT"/sys/class/net/*; do
        [ -d "$ifpath" ] || continue
        iface=$(basename "$ifpath")
        [ "$iface" = "lo" ] && continue
        rps=$(cat "$ifpath"/queues/rx-0/rps_cpus 2>/dev/null || echo "N/A")
        txq=$(cat "$ifpath"/tx_queue_len 2>/dev/null || echo "N/A")
        oper=$(cat "$ifpath"/operstate 2>/dev/null || echo "unknown")
        printf "  %-12s %-10s %-12s [%s]\n" "$iface" "$rps" "$txq" "$oper"
    done

    echo ""
    echo "--- 4. TCP Congestion & Buffer Metrics ---"
    cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "cubic")
    rmem=$(sysctl -n net.core.rmem_max 2>/dev/null || echo "0")
    wmem=$(sysctl -n net.core.wmem_max 2>/dev/null || echo "0")
    backlog=$(sysctl -n net.core.netdev_max_backlog 2>/dev/null || echo "0")
    budget=$(sysctl -n net.core.netdev_budget 2>/dev/null || echo "0")
    conns=$(cat "$SPEED_ROOT/proc/sys/net/netfilter/nf_conntrack_count" 2>/dev/null || echo "N/A")
    echo "  TCP Congestion: $cc | Max RCV: $((rmem/1024/1024))MB | Max SND: $((wmem/1024/1024))MB"
    echo "  Backlog Queue: $backlog | NAPI Budget: $budget pkts/cycle | Active Conntrack: $conns"
    echo "--- 5. WAN, Ethernet, CPU and thermal diagnostics ---"
    ifstatus wan 2>/dev/null || true
    cat "$SPEED_ROOT/proc/interrupts" "$SPEED_ROOT/proc/softirqs" "$SPEED_ROOT/proc/net/softnet_stat" 2>/dev/null || true
    for temp in "$SPEED_ROOT"/sys/class/thermal/thermal_zone*/temp; do
        [ ! -r "$temp" ] || printf '%s: %s\n' "$temp" "$(cat "$temp")"
    done
    if command -v ethtool >/dev/null 2>&1; then
        ethtool eth0 2>/dev/null || true
        ethtool eth1 2>/dev/null || true
    fi
    command -v tc >/dev/null 2>&1 && tc -s qdisc show 2>/dev/null || true
    echo "--- 6. Cached modem telemetry (capture while a download is running) ---"
    for info in modem_cell_info modem_ca_info modem_sign_info modem_band_info; do
        [ ! -r "$SPEED_ROOT/tmp/$info.json" ] || cat "$SPEED_ROOT/tmp/$info.json"
    done
    echo "=================================================================="
}
