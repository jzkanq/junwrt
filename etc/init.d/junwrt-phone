#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    [ -c /dev/spidev0.0 ] || return 1
    [ -x /usr/bin/ruby ] || return 1
    procd_open_instance
    procd_set_param command /usr/bin/ruby /usr/bin/junwrt-phone
    [ -z "$JUNWRT_PHONE_TEST_NUMBER" ] || procd_set_param env JUNWRT_PHONE_TEST_NUMBER="$JUNWRT_PHONE_TEST_NUMBER"
    procd_set_param respawn 3600 10 10
    procd_set_param term_timeout 20
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
