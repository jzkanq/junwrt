#!/bin/sh /etc/rc.common
START=97
STOP=11
USE_PROCD=1

# Always running so Support never shows a stopped service; it only reads the modem while recording is on.
start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/junwrt-signal daemon
    procd_set_param respawn 3600 30 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
