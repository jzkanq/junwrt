#!/bin/sh /etc/rc.common
START=97
STOP=11
USE_PROCD=1

# Always running so Support never shows a stopped service; it idles while the schedule is off.
start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/junwrt-wifisched daemon
    procd_set_param respawn 3600 30 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

# Give Wi-Fi back if the service stops during the off time.
stop_service() {
    [ -e /var/run/junwrt-wifisched/off ] || return 0
    for name in $(sort /var/run/junwrt-wifisched/off); do
        case "$name" in ra[0-9]|ra[0-9][0-9]|rai[0-9]|rai[0-9][0-9]) ifconfig "$name" up ;; esac
    done
    rm -f /var/run/junwrt-wifisched/off
}
