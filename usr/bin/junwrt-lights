#!/bin/sh
# JunWRT Light Control: switch the front-panel LEDs off and keep them off.
# The master switch is the vendor led_ctrld flag lights_enabled, the flag its lights button toggles.
# led_ctrld rewrites an LED whenever its state changes (other vendor programs write LEDs too), so
# single lights are held by a small supervisor. The panel LEDs are plain on/off GPIO LEDs: no dimming.
# Writes only /sys/class/leds/<name>/{trigger,brightness}: no GPIO export, nothing near the RF helpers.

ROOT="${JUNWRT_LIGHTS_ROOT:-}" # test hook: prefix for the paths below
CONFIG=junwrt-lights
VENDOR=led_ctrld.default_setting
CONF_FILE="$ROOT/etc/config/$CONFIG"
VENDOR_CONF="$ROOT/etc/config/led_ctrld"
LEDS="$ROOT/sys/class/leds"
RUN_DIR="$ROOT/var/run/junwrt-lights"
ORIG="$RUN_DIR/orig"
ALIVE="$RUN_DIR/alive"
UPTIME_FILE="$ROOT/proc/uptime"
VENDOR_INIT="${JUNWRT_LIGHTS_VENDOR:-/etc/init.d/led_ctrld.init}"
BUSY=2 # seconds between passes while a light is held
IDLE=5 # seconds between passes while every light is left to the vendor controller
WRITE_FAILS=0

die() {
	printf '{"error":"%s"}\n' "$1"
	exit 1
}

clean() {
	printf '%s' "$1" | tr -d '\001-\037\042\134\177' | cut -c1-"${2:-160}"
}

# valid_name NAME: an LED directory name that cannot step outside /sys/class/leds.
valid_name() {
	case "$1" in
		''|.*|*[!A-Za-z0-9_:.-]*) return 1 ;;
	esac
	[ "${#1}" -le 64 ]
}

has_word() {
	case " $1 " in
		*" $2 "*) return 0 ;;
	esac
	return 1
}

# first_line FILE: sets LINE to the first line (empty when unreadable) without a subshell.
first_line() {
	LINE=""
	{ read -r LINE < "$1" || [ -n "$LINE" ]; } 2>/dev/null
}

# led_read PATH: sets L_TRIG (active trigger) and L_BRI.
led_read() {
	local t
	L_TRIG=""
	L_BRI=0
	first_line "$1/trigger"
	case "$LINE" in
		*\[*\]*) t="${LINE#*\[}"; L_TRIG="${t%%\]*}" ;;
	esac
	first_line "$1/brightness"
	case "$LINE" in
		''|*[!0-9]*) ;;
		*) L_BRI="$LINE" ;;
	esac
}

# led_set PATH FILE VALUE: one sysfs write; a refusal is counted and reported, never fatal.
led_set() {
	{ printf '%s\n' "$3" > "$1/$2"; } 2>/dev/null || WRITE_FAILS=$((WRITE_FAILS + 1))
}

# Master flag from the vendor controller (same values its toggle script treats as off), then our list.
load_config() {
	local line key value
	MASTER=on
	OFF_LIST=""
	value="$(uci -q get "$VENDOR.lights_enabled" 2>/dev/null)"
	case "$value" in
		0|off|false|disabled) MASTER=off ;;
	esac
	while IFS= read -r line; do
		case "$line" in
			"$CONFIG.main."*) ;;
			*) continue ;;
		esac
		key="${line#"$CONFIG.main."}"
		value="${key#*=}"
		key="${key%%=*}"
		value="${value#\'}"
		value="${value%\'}"
		[ "$key" = off ] && OFF_LIST="$value"
	done <<EOF
$(uci -q show "$CONFIG.main" 2>/dev/null)
EOF
	return 0
}

# wanted: something has to be held (lights off, or a dark LED).
wanted() {
	[ "$MASTER" = off ] || [ -n "$OFF_LIST" ]
}

# held MASTER OFF_LIST NAME: succeeds when the light has to stay dark.
held() {
	[ "$1" = off ] || has_word "$2" "$3"
}

# drop_name LIST NAME: LIST without NAME.
drop_name() {
	local item out=""
	for item in $1; do
		[ "$item" = "$2" ] || out="${out:+$out }$item"
	done
	printf '%s' "$out"
}

# remember NAME: keep how the LED looked before our first change this boot (after led_read).
remember() {
	[ -e "$ORIG/$1" ] && return 0
	mkdir -p "$ORIG" 2>/dev/null
	printf '%s %s\n' "${L_TRIG:--}" "$L_BRI" > "$ORIG/$1" 2>/dev/null
}

# release NAME: put the remembered trigger and brightness back.
release() {
	local t b
	[ -f "$ORIG/$1" ] || return 0
	read -r t b < "$ORIG/$1"
	rm -f "$ORIG/$1"
	[ -d "$LEDS/$1" ] || return 0
	[ "$t" = - ] || led_set "$LEDS/$1" trigger "$t"
	case "$b" in
		''|*[!0-9]*) ;;
		*) led_set "$LEDS/$1" brightness "$b" ;;
	esac
}

# force_off PATH NAME: dark and trigger-free; call after led_read.
force_off() {
	if [ -z "$L_TRIG" ] || [ "$L_TRIG" = none ]; then
		[ "$L_BRI" = 0 ] && return 0
	fi
	remember "$2"
	[ -z "$L_TRIG" ] || [ "$L_TRIG" = none ] || led_set "$1" trigger none
	led_set "$1" brightness 0
}

# enforce: darken every LED that has to stay dark. Needs MASTER and OFF_LIST.
enforce() {
	local path led
	for path in "$LEDS"/*; do
		[ -d "$path" ] || continue
		led="${path##*/}"
		valid_name "$led" || continue
		held "$MASTER" "$OFF_LIST" "$led" || continue
		led_read "$path"
		force_off "$path" "$led"
	done
}

# discover: sets LED_NAMES to the valid LED names that exist right now.
discover() {
	local path name
	LED_NAMES=""
	for path in "$LEDS"/*; do
		[ -d "$path" ] || continue
		name="${path##*/}"
		valid_name "$name" && LED_NAMES="${LED_NAMES:+$LED_NAMES }$name"
	done
	return 0
}

# put_list KEY VALUE: store a space-separated list, or drop the option when it is empty.
put_list() {
	if [ -n "$2" ]; then
		uci -q set "$CONFIG.main.$1=$2" || die "Could not save $1."
	else
		uci -q delete "$CONFIG.main.$1" >/dev/null 2>&1
	fi
	return 0
}

set_master() {
	local flag=1
	[ "$1" = off ] && flag=0
	[ -f "$VENDOR_CONF" ] || touch "$VENDOR_CONF" 2>/dev/null
	uci -q set led_ctrld.default_setting=setting && uci -q set "$VENDOR.lights_enabled=$flag" && uci -q commit led_ctrld ||
		die "Could not change the lights switch."
	logger -t junwrt-lights "lights $1" 2>/dev/null
}

# The vendor service reads lights_enabled at start and redraws every LED; LED_TOGGLE_RESTART skips its shutdown blink.
restart_vendor() {
	[ -x "$VENDOR_INIT" ] || return 0
	LED_TOGGLE_RESTART=1 "$VENDOR_INIT" restart >/dev/null 2>&1
	return 0
}

report_writes() {
	[ "$WRITE_FAILS" -eq 0 ] || die "Saved, but $WRITE_FAILS light change(s) were refused by the hardware."
	printf '{"success":true}\n'
}

status() {
	local path led sep="" mode state running=0 beat up wants=0
	load_config
	wanted && wants=1
	first_line "$ALIVE"
	beat="$LINE"
	first_line "$UPTIME_FILE"
	up="${LINE%%.*}"
	if [ -n "$beat" ] && [ -n "$up" ]; then
		case "$beat$up" in
			*[!0-9]*) ;;
			*) [ "$up" -ge "$beat" ] && [ $((up - beat)) -le $((IDLE * 2 + 5)) ] && running=1 ;;
		esac
	fi
	printf '{"lights":"%s","wanted":%s,"running":%s,"now":%s,"leds":[' "$MASTER" "$wants" "$running" "$(date +%s)"
	for path in "$LEDS"/*; do
		[ -d "$path" ] || continue
		led="${path##*/}"
		valid_name "$led" || continue
		led_read "$path"
		mode=on
		has_word "$OFF_LIST" "$led" && mode=off
		case "$L_TRIG" in
			''|none) if [ "$L_BRI" -gt 0 ]; then state=lit; else state=dark; fi ;;
			timer) state=blink ;;
			*) state=auto ;;
		esac
		printf '%s{"name":"%s","brightness":%s,"trigger":"%s","state":"%s","mode":"%s"}' \
			"$sep" "$led" "$L_BRI" "$(clean "$L_TRIG" 32)" "$state" "$mode"
		sep=,
	done
	printf ']}\n'
}

# save lights=on|off led.NAME=on|off ...: validated first, applied only when every pair is good.
save() {
	local arg key value name old_master old_off new_off want_master="" restart=0
	[ $# -gt 0 ] || die "Nothing to save."
	discover
	for arg in "$@"; do
		case "$arg" in
			*=*) ;;
			*) die "Use key=value pairs." ;;
		esac
		key="${arg%%=*}"
		value="${arg#*=}"
		case "$key" in
			lights)
				case "$value" in
					on|off) ;;
					*) die "lights must be on or off." ;;
				esac ;;
			led.*)
				name="${key#led.}"
				valid_name "$name" && has_word "$LED_NAMES" "$name" || die "Unknown light: $(clean "$name" 40)."
				case "$value" in
					on|off) ;;
					*) die "A light can only be on or off; these LEDs have no brightness control." ;;
				esac ;;
			*) die "Unknown setting: $(clean "$key" 24)." ;;
		esac
	done
	load_config
	old_master="$MASTER"
	old_off="$OFF_LIST"
	new_off="$OFF_LIST"
	for arg in "$@"; do
		key="${arg%%=*}"
		value="${arg#*=}"
		case "$key" in
			lights) want_master="$value" ;;
			led.*)
				name="${key#led.}"
				new_off="$(drop_name "$new_off" "$name")"
				[ "$value" = off ] && new_off="${new_off:+$new_off }$name"
				;;
		esac
	done
	[ -f "$CONF_FILE" ] || touch "$CONF_FILE" 2>/dev/null || die "Could not create the configuration."
	uci -q get "$CONFIG.main" >/dev/null 2>&1 || uci -q set "$CONFIG.main=lights" || die "Could not create the configuration section."
	put_list off "$new_off"
	uci -q delete "$CONFIG.main.dim" >/dev/null 2>&1 # retired option from the first release
	uci -q commit "$CONFIG" || die "Could not commit the configuration."
	if [ -n "$want_master" ] && [ "$want_master" != "$old_master" ]; then
		set_master "$want_master"
		restart=1
	fi
	MASTER="${want_master:-$old_master}"
	OFF_LIST="$new_off"
	# A light coming back from dark gets its remembered state; the vendor controller then redraws it.
	for name in $LED_NAMES; do
		if held "$old_master" "$old_off" "$name" && ! held "$MASTER" "$new_off" "$name"; then
			release "$name"
			restart=1
		fi
	done
	[ "$MASTER" = off ] && enforce
	[ "$restart" = 1 ] && restart_vendor
	enforce
	report_writes
}

# restore: factory behavior. Forget our list, switch the vendor flag on and hand every LED back.
restore() {
	local name
	discover
	uci -q delete "$CONFIG.main" >/dev/null 2>&1
	uci -q commit "$CONFIG" >/dev/null 2>&1
	set_master on
	for name in $LED_NAMES; do
		release "$name"
	done
	restart_vendor
	rm -rf "$ORIG" 2>/dev/null
	report_writes
}

run_daemon() {
	local loops=0 pause
	mkdir -p "$RUN_DIR" 2>/dev/null
	while :; do
		load_config
		if wanted; then
			enforce
			pause="$BUSY"
		else
			pause="$IDLE"
		fi
		first_line "$UPTIME_FILE"
		printf '%s\n' "${LINE%%.*}" > "$ALIVE" 2>/dev/null
		sleep "$pause"
		loops=$((loops + 1))
		[ -z "$JUNWRT_LIGHTS_LOOPS" ] || [ "$loops" -lt "$JUNWRT_LIGHTS_LOOPS" ] || break
	done
}

case "${1:-}" in
	status) status ;;
	save) shift; save "$@" ;;
	restore) restore ;;
	daemon|run) run_daemon ;;
	*) echo "Usage: $0 {status|save key=value...|restore|daemon}"; exit 2 ;;
esac
