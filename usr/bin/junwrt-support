#!/bin/sh
# JunWRT support helper: the installed WebUI build, a file check against the installer manifest and a
# diagnostics bundle (secrets removed) that can be attached to a support request.

ROOT="${JUNWRT_SUPPORT_ROOT:-}" # test hook: prefix for the paths below
BUILD_FILE="$ROOT/etc/junwrt-webui.build"
MANIFEST="$ROOT/etc/junwrt-webui.manifest"
MAX_PROBLEMS=8

die() {
	printf '{"error":"%s"}\n' "$1"
	exit 1
}

clean() {
	printf '%s' "$1" | tr -d '\001-\037\042\134\177' | cut -c1-"${2:-160}"
}

num() {
	case "$1" in
		''|*[!0-9]*) printf '0' ;;
		*) printf '%s' "$1" ;;
	esac
}

build_value() {
	sed -n "s/^$1=//p" "$BUILD_FILE" 2>/dev/null | head -n 1 | tr -d '\r'
}

# verify: sets V_TOTAL V_OK V_CHANGED V_MISSING and V_PROBLEMS (JSON strings) from the manifest.
verify() {
	local sum path got listed=0 seen="" expected
	V_TOTAL=0; V_OK=0; V_CHANGED=0; V_MISSING=0; V_PROBLEMS=""; V_ERROR=""
	[ -r "$MANIFEST" ] || { V_ERROR="The file manifest is missing or unreadable."; return 1; }
	while read -r sum path || [ -n "$sum$path" ]; do
		[ -n "$sum$path" ] || continue
		case "$sum" in
			*[!a-fA-F0-9]*) V_ERROR="The file manifest contains an invalid checksum."; continue ;;
		esac
		[ "${#sum}" -eq 64 ] || { V_ERROR="The file manifest contains an invalid checksum."; continue; }
		case "$path" in
			*'/../'*|*'/./'*|*'//'*) V_ERROR="The file manifest contains an invalid path."; continue ;;
			/*) ;;
			*) V_ERROR="The file manifest contains an invalid path."; continue ;;
		esac
		case "$seen" in
			*"
$path
"*) V_ERROR="The file manifest contains duplicate paths."; continue ;;
		esac
		seen="$seen
$path
"
		V_TOTAL=$((V_TOTAL + 1))
		if [ ! -f "$ROOT$path" ]; then
			V_MISSING=$((V_MISSING + 1))
			got=missing
		else
			got="$(sha256sum "$ROOT$path" 2>/dev/null | cut -d' ' -f1)"
			if [ "$got" = "$sum" ]; then
				V_OK=$((V_OK + 1))
				continue
			fi
			V_CHANGED=$((V_CHANGED + 1))
			got=changed
		fi
		if [ "$listed" -lt "$MAX_PROBLEMS" ]; then
			V_PROBLEMS="${V_PROBLEMS}${V_PROBLEMS:+,}{\"path\":\"$(clean "$path" 120)\",\"state\":\"$got\"}"
			listed=$((listed + 1))
		fi
	done < "$MANIFEST"
	[ "$V_TOTAL" -gt 0 ] || V_ERROR="The file manifest has no valid entries."
	if [ -f "$BUILD_FILE" ]; then
		expected="$(num "$(build_value files)")"
		if [ "$expected" -eq 0 ]; then
			V_ERROR="The build record has no valid file count."
		elif [ "$V_TOTAL" -ne "$expected" ]; then
			V_ERROR="The file manifest count differs from the build record."
		fi
	fi
	[ -z "$V_ERROR" ] || return 1
	return 0
}

service_state() {
	local name="$1" reply kind states state
	# This vendor rc.common defaults service_running() to success, even without a daemon.
	# Query the same procd instances as lib/functions/procd.sh, without trusting that exit code.
	reply="$(ubus call service list "{\"name\":\"$name\"}" 2>/dev/null)" || { printf null; return; }
	kind="$(jsonfilter -s "$reply" -t '@' 2>/dev/null)"
	[ "$kind" = object ] || { printf null; return; }
	states="$(jsonfilter -s "$reply" -e "@['$name'].instances.*.running" 2>/dev/null)"
	for state in $states; do
		case "$state" in
			true) printf true; return ;;
			false) ;;
			*) printf null; return ;;
		esac
	done
	printf false
}

services_json() {
	local first=1 name
	printf '{'
	for name in $(build_value services); do
		case "$name" in
			*[!A-Za-z0-9_-]*) continue ;;
		esac
		printf '%s"%s":%s' "$([ "$first" = 1 ] || printf ',')" "$name" \
			"$(service_state "$name")"
		first=0
	done
	printf '}'
}

status() {
	local installed=false uptime kb overlay load
	[ -f "$BUILD_FILE" ] && installed=true
	verify
	uptime="$(num "$(cut -d. -f1 "$ROOT/proc/uptime" 2>/dev/null)")"
	kb="$(sed -n 's/^MemAvailable: *\([0-9]*\) kB.*/\1/p' "$ROOT/proc/meminfo" 2>/dev/null | head -n 1)"
	load="$(cut -d' ' -f1 "$ROOT/proc/loadavg" 2>/dev/null)"
	overlay="$(df -k "$ROOT/overlay" 2>/dev/null | sed -n '2p' | tr -s ' ' | cut -d' ' -f4)"
	printf '{"installed":%s,"build":{"time":"%s","epoch":%s,"payload":"%s","files":%s,"modules":"%s"},' \
		"$installed" "$(clean "$(build_value built)" 40)" "$(num "$(build_value epoch)")" "$(clean "$(build_value payload)" 16)" \
		"$(num "$(build_value files)")" "$(clean "$(build_value modules)" 160)"
	printf '"verify":{"total":%s,"ok":%s,"changed":%s,"missing":%s,"error":"%s","problems":[%s]},' "$V_TOTAL" "$V_OK" "$V_CHANGED" "$V_MISSING" "$(clean "$V_ERROR")" "$V_PROBLEMS"
	printf '"system":{"uptime":%s,"load":"%s","mem_available_kb":%s,"overlay_free_kb":%s},"services":%s,"now":%s}\n' \
		"$uptime" "$(clean "$load" 12)" "$(num "$kb")" "$(num "$overlay")" "$(services_json)" "$(date +%s)"
}

# Secrets never leave the router: option names that look like secrets lose their value, long digit
# runs (IMEI, IMSI, ICCID) are hidden.
redact() {
	sed -E -e "s/^([^=]*(key|psk|password|passwd|token|secret|pin|private|auth|login)[^=]*)=.*/\1='<hidden>'/" \
		-e 's/[0-9]{15,20}/<digits-hidden>/g'
}

collect() { # directory
	local dir="$1"
	{
		echo "== build"; cat "$BUILD_FILE" 2>/dev/null
		echo "== uname"; uname -a
		echo "== uptime"; uptime
		echo "== memory"; free 2>/dev/null
		echo "== disk"; df -h 2>/dev/null
		echo "== board"; ubus call system board 2>/dev/null
	} > "$dir/system.txt" 2>&1
	{
		echo "== wan"; ifstatus wan 2>/dev/null
		echo "== addresses"; ip addr 2>/dev/null
		echo "== routes"; ip route 2>/dev/null
	} 2>&1 | redact > "$dir/network.txt"
	{ logread 2>/dev/null | tail -n 400; } | redact > "$dir/log.txt"
	{ dmesg 2>/dev/null | tail -n 200; } | redact > "$dir/kernel.txt"
	uci show 2>/dev/null | redact > "$dir/config.txt"
	if [ -x "$ROOT/usr/share/3ginfo-lite/3ginfo.sh" ]; then
		"$ROOT/usr/share/3ginfo-lite/3ginfo.sh" json 2>/dev/null | redact > "$dir/modem.txt"
	fi
	{
		echo "== file check"
		verify
		echo "total=$V_TOTAL ok=$V_OK changed=$V_CHANGED missing=$V_MISSING"
		[ -z "$V_ERROR" ] || echo "verification_error=$V_ERROR"
		echo "== services"; services_json; echo
		echo "== speed test towers"; "$ROOT/usr/bin/junwrt-speedtest" towers 2>/dev/null
		echo "== data usage"; "$ROOT/usr/bin/junwrt-usage" status 2>/dev/null
		echo "== connection guard"; "$ROOT/usr/bin/junwrt-guard" status 2>/dev/null
		echo "== security"; "$ROOT/usr/bin/junwrt-security" status 2>/dev/null
	} 2>&1 | redact > "$dir/junwrt.txt"
	# Capture while the slow transfer is running: distinguish inactive NR from CPU/forwarding limits.
	if [ -x "$ROOT/etc/init.d/junspeedpatch" ]; then
		"$ROOT/etc/init.d/junspeedpatch" status 2>&1 | redact > "$dir/performance.txt"
	fi
}

bundle() {
	local dir="${TMPDIR:-/tmp}/junwrt-support.$$" result
	# Never reuse an existing folder; cleanup owns only the directory we created.
	mkdir "$dir" || die "Could not create a temporary folder."
	trap 'rm -rf "$dir"' EXIT
	collect "$dir"
	tar -czf - -C "$dir" . 2>/dev/null
	result=$?
	rm -rf "$dir"
	trap - EXIT
	return "$result"
}

case "${1:-}" in
	status) status ;;
	bundle) bundle ;;
	verify) verify; printf '{"total":%s,"ok":%s,"changed":%s,"missing":%s,"error":"%s"}\n' "$V_TOTAL" "$V_OK" "$V_CHANGED" "$V_MISSING" "$(clean "$V_ERROR")"
		[ -z "$V_ERROR" ] && [ "$V_TOTAL" -gt 0 ] && [ "$V_CHANGED" = 0 ] && [ "$V_MISSING" = 0 ] ;;
	*) echo "Usage: $0 {status|verify|bundle}"; exit 2 ;;
esac
