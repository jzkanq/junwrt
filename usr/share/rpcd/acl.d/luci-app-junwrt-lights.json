{
  "luci-app-junwrt-lights": {
    "description": "Turn the front-panel lights off, pick their colour or run a light show",
    "read": {
      "ubus": {
        "file": [
          "exec"
        ]
      },
      "file": {
        "/usr/bin/junwrt-lights status": [
          "exec"
        ]
      }
    },
    "write": {
      "ubus": {
        "file": [
          "exec"
        ]
      },
      "file": {
        "/usr/bin/junwrt-lights save *": [
          "exec"
        ],
        "/usr/bin/junwrt-lights restore": [
          "exec"
        ],
        "/usr/bin/junwrt-lights disco *": [
          "exec"
        ]
      }
    }
  }
}
